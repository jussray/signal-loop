{
  "name": "signal-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof-first build-in-public: verified commits to social drafts, behind a truth firewall.",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings dev/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "e2e": "node --experimental-strip-types --no-warnings e2e/flow.e2e.ts",
    "deploy": "wrangler d1 migrations apply signal-loop --remote && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
